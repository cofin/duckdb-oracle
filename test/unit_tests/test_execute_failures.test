# name: test/unit_tests/test_execute_failures.test
# description: oracle_execute should fail gracefully on bad credentials without crashing
# group: [unit_tests]

require oracle

# Expect a clean error (no segfault) when connection fails
statement error
SELECT oracle_execute('bad_user/bad_pass@//localhost:1521/NO_DB', 'DELETE FROM DUAL');
----
IO Error

# Reject oracle_execute inside an explicit DuckDB transaction
statement ok
BEGIN TRANSACTION;

statement error
SELECT oracle_execute('bad_user/bad_pass@//localhost:1521/NO_DB', 'DELETE FROM DUAL');
----
explicit DuckDB transaction

statement ok
ROLLBACK;

