# name: test/unit_tests/test_wallet_and_settings.test
# description: Negative scan connectivity and wallet path validation
# group: [unit_tests]

# tags: [oracle]

require oracle

# invalid connection should raise IO error (OCI unavailable in CI)
statement error
SELECT * FROM oracle_scan('dummy/dummy@//localhost:1521/dummy', 'HR', 'EMPLOYEES');
----
IO Error

# oracle_attach_wallet is no longer a public function; use CREATE SECRET WALLET_PATH.
statement error
SELECT oracle_attach_wallet('.');
----
oracle_attach_wallet

# wallet path must exist when declared on an Oracle secret
statement error
CREATE SECRET wallet_missing (
    TYPE oracle,
    USER 'duckdb_test',
    PASSWORD 'duckdb_test',
    HOST 'localhost',
    PORT 1521,
    SERVICE 'FREEPDB1',
    WALLET_PATH '/this/path/does/not/exist'
);
----
WALLET_PATH does not exist

# Existing wallet directory (current directory) is accepted on secrets.
statement ok
CREATE SECRET wallet_ok (
    TYPE oracle,
    USER 'duckdb_test',
    PASSWORD 'duckdb_test',
    HOST 'localhost',
    PORT 1521,
    SERVICE 'FREEPDB1',
    WALLET_PATH '.'
);

query I
SELECT count(*) FROM duckdb_secrets() WHERE type = 'oracle' AND name = 'wallet_ok';
----
1

# ATTACH-level WALLET_PATH is validated before OCI connection setup.
statement error
ATTACH 'user/password@host:1521/service' AS wallet_missing_attach (
    TYPE oracle,
    WALLET_PATH '/this/path/does/not/exist'
);
----
WALLET_PATH does not exist

# Existing ATTACH-level WALLET_PATH is accepted and proceeds to normal OCI connection handling.
statement error
ATTACH 'user/password@host:1521/service' AS wallet_ok_attach (
    TYPE oracle,
    WALLET_PATH '.'
);
----
Cannot connect to database
