# name: test/unit_tests/test_query_function.test
# description: Test a simple query (expecting connection failure in CI)
# group: [unit_tests]

# tags: [oracle]

# load the extension
require oracle

# run a query with dummy credentials
# We expect an IO Error or similar due to missing OCI or connection failure
statement error
SELECT * FROM oracle_query('dummy/dummy@//localhost:1521/dummy', 'SELECT 1 FROM DUAL');
----
IO Error

# Reject empty or whitespace-only SQL in oracle_query
statement error
SELECT * FROM oracle_query('dummy/dummy@//localhost:1521/dummy', '   ;  ');
----
cannot be empty

# Reject specifying both as_of_scn and as_of_timestamp in oracle_scan
statement error
SELECT * FROM oracle_scan('dummy/dummy@//localhost:1521/dummy', 'HR', 'EMPLOYEES', as_of_scn = 100, as_of_timestamp = '2026-01-01 00:00:00');
----
cannot specify both as_of_scn and as_of_timestamp

