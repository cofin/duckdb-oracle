# name: test/integration_tests/oracle/write.test
# description: Integration tests for Oracle attached INSERT write support
# group: [oracle]

require oracle

# Build connection string from environment
statement ok
CREATE OR REPLACE MACRO oracle_test_conn() AS '${ORACLE_CONNECTION_STRING}';

statement ok
CREATE OR REPLACE SECRET test_oracle (
    TYPE ORACLE,
    USER '${ORACLE_USER}',
    PASSWORD '${ORACLE_PASSWORD}',
    HOST '${ORACLE_HOST}',
    PORT ${ORACLE_PORT},
    SERVICE '${ORACLE_SERVICE}'
);

statement ok
ATTACH '' AS ora (TYPE ORACLE, SECRET 'test_oracle')

# Set up test table
statement ok
SELECT oracle_execute(oracle_test_conn(), '
    BEGIN
       EXECUTE IMMEDIATE ''DROP TABLE test_write_types'';
    EXCEPTION
       WHEN OTHERS THEN
          IF SQLCODE != -942 THEN
             RAISE;
          END IF;
    END;
')

statement ok
SELECT oracle_execute(oracle_test_conn(), '
    CREATE TABLE test_write_types (
        id NUMBER PRIMARY KEY,
        int_col NUMBER(10),
        float_col FLOAT,
        double_col BINARY_DOUBLE,
        date_col DATE,
        ts_col TIMESTAMP,
        blob_col BLOB,
        str_col VARCHAR2(100)
    )
')

# Insert data through the attached Oracle table
statement ok
INSERT INTO ora.test_write_types (id, int_col, float_col, double_col, date_col, ts_col, blob_col, str_col)
VALUES (1, 42, 3.14, 2.718, '2023-01-01'::DATE, '2023-01-01 12:34:56.789'::TIMESTAMP, '\xAB\xCD\xEF'::BLOB, 'hello world');

# Fetch and verify data
query TTTTTTTT
SELECT * FROM ora.test_write_types ORDER BY id;
----
1.0
42
3.14
2.718
2023-01-01 00:00:00
2023-01-01 12:34:56.789
\xAB\xCD\xEF
hello world

statement ok
INSERT INTO ora.duckdb_test.test_write_types (id, int_col, float_col, double_col, date_col, ts_col, blob_col, str_col)
VALUES (4, 7, 1.25, 9.5, '2024-02-03'::DATE, '2024-02-03 04:05:06.789'::TIMESTAMP, '\x01\x02'::BLOB, 'schema-qualified-ok');

query I
SELECT * FROM oracle_query(oracle_test_conn(), 'SELECT COUNT(*) FROM test_write_types WHERE id = 4 AND str_col = ''schema-qualified-ok''');
----
1

query I
INSERT INTO ora.test_write_types (id, int_col, str_col)
SELECT i::INTEGER AS id, i::INTEGER AS int_col, 'multi-chunk-owned' AS str_col
FROM range(10000, 15100) tbl(i);
----
5100

query I
SELECT * FROM oracle_query(oracle_test_conn(), 'SELECT COUNT(*) FROM test_write_types WHERE str_col = ''multi-chunk-owned''');
----
5100

statement ok
SELECT oracle_execute(oracle_test_conn(), '
    BEGIN
       EXECUTE IMMEDIATE ''DROP TABLE WRITEMETAMIXED'';
    EXCEPTION
       WHEN OTHERS THEN
          IF SQLCODE != -942 THEN
             RAISE;
          END IF;
    END;
')

statement ok
SELECT oracle_execute(oracle_test_conn(), '
    BEGIN
       EXECUTE IMMEDIATE ''DROP TABLE "WriteMetaMixed"'';
    EXCEPTION
       WHEN OTHERS THEN
          IF SQLCODE != -942 THEN
             RAISE;
          END IF;
    END;
')

statement ok
SELECT oracle_execute(oracle_test_conn(), '
    CREATE TABLE "WriteMetaMixed" (
        "Id" NUMBER PRIMARY KEY,
        "PayloadText" VARCHAR2(100)
    )
')

statement ok
SELECT oracle_execute(oracle_test_conn(), '
    CREATE TABLE WRITEMETAMIXED (
        id NUMBER PRIMARY KEY
    )
')

statement ok
SELECT oracle_execute(oracle_test_conn(), '
    BEGIN
       EXECUTE IMMEDIATE ''DROP TABLE "write_meta_x'''') OR 1=1 --"'';
    EXCEPTION
       WHEN OTHERS THEN
          IF SQLCODE != -942 THEN
             RAISE;
          END IF;
    END;
')

statement ok
SELECT oracle_execute(oracle_test_conn(), '
    CREATE TABLE "write_meta_x'') OR 1=1 --" (
        "id" NUMBER PRIMARY KEY,
        "payload''col" VARCHAR2(100)
    )
')

statement ok
SELECT oracle_clear_cache();

statement ok
INSERT INTO ora."WriteMetaMixed"
VALUES (2, 'mixed-case-ok');

statement ok
INSERT INTO ora."write_meta_x') OR 1=1 --"
VALUES (3, 'quote-safe');

query I
SELECT * FROM oracle_query(oracle_test_conn(), 'SELECT COUNT(*) FROM "WriteMetaMixed" WHERE "PayloadText" = ''mixed-case-ok''');
----
1

query I
SELECT * FROM oracle_query(oracle_test_conn(), 'SELECT COUNT(*) FROM "write_meta_x'') OR 1=1 --" WHERE "payload''col" = ''quote-safe''');
----
1

# Clean up
statement ok
SELECT oracle_execute(oracle_test_conn(), 'DROP TABLE "write_meta_x'') OR 1=1 --"')

statement ok
SELECT oracle_execute(oracle_test_conn(), 'DROP TABLE "WriteMetaMixed"')

statement ok
SELECT oracle_execute(oracle_test_conn(), 'DROP TABLE WRITEMETAMIXED')

statement ok
SELECT oracle_execute(oracle_test_conn(), 'DROP TABLE test_write_types')
