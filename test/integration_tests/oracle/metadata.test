# name: test/integration_tests/oracle/metadata.test
# description: Integration tests for lazy schema loading and metadata scalability
# group: [oracle]

# require: oracle_available

require oracle

statement ok
CREATE OR REPLACE MACRO oracle_test_conn() AS '${ORACLE_CONNECTION_STRING}';

# Test 1: Metadata result limit
statement ok
SET oracle_metadata_result_limit = 5;

query I
SELECT COUNT(*) FROM oracle_query(oracle_test_conn(),
    'SELECT * FROM all_objects WHERE rownum <= 10');
----
10

# Connection params are rendered by scripts/test_integration.sh.

# Setup: Create test secret
statement ok
CREATE SECRET oracle_meta_test (
    TYPE oracle,
    HOST '${ORACLE_HOST}',
    PORT ${ORACLE_PORT},
    SERVICE '${ORACLE_SERVICE}',
    USER '${ORACLE_USER}',
    PASSWORD '${ORACLE_PASSWORD}'
);

statement ok
SELECT oracle_execute(oracle_test_conn(), '
    BEGIN
       EXECUTE IMMEDIATE ''DROP TABLE aaa_read_limit_source'';
    EXCEPTION
       WHEN OTHERS THEN
          IF SQLCODE != -942 THEN
             RAISE;
          END IF;
    END;
')

statement ok
SELECT oracle_execute(oracle_test_conn(), '
    BEGIN
       EXECUTE IMMEDIATE ''DROP TABLE zzz_read_limit_target'';
    EXCEPTION
       WHEN OTHERS THEN
          IF SQLCODE != -942 THEN
             RAISE;
          END IF;
    END;
')

statement ok
SELECT oracle_execute(oracle_test_conn(), '
    CREATE TABLE aaa_read_limit_source (
        id NUMBER
    )
')

statement ok
SELECT oracle_execute(oracle_test_conn(), '
    CREATE TABLE zzz_read_limit_target (
        id NUMBER
    )
')

statement ok
SELECT oracle_execute(oracle_test_conn(), 'INSERT INTO zzz_read_limit_target VALUES (1)')

# Test 1: Test lazy schema loading enabled (default)
statement ok
SET oracle_metadata_result_limit = 10000;
SET oracle_lazy_schema_loading = true;

# Attach with lazy loading - should only enumerate current schema
statement ok
ATTACH '' AS ora_lazy (TYPE oracle, SECRET oracle_meta_test);

# Test 2: Verify duckdb_databases() metadata and credential redaction
query IIII
SELECT database_name, type, internal, readonly FROM duckdb_databases() WHERE database_name = 'ora_lazy';
----
ora_lazy	oracle	false	false

query I
SELECT path LIKE '%***@%' FROM duckdb_databases() WHERE database_name = 'ora_lazy';
----
true

# Test 2b: Verify current schema was detected in both duckdb_schemas() and duckdb_schemas view
query I
SELECT COUNT(*) > 0 FROM duckdb_schemas() WHERE database_name = 'ora_lazy';
----
true

query I
SELECT COUNT(*) > 0 FROM duckdb_schemas WHERE database_name = 'ora_lazy' AND NOT internal;
----
true

# Test 2c: Verify duckdb_tables, duckdb_columns, and information_schema views enumerate Oracle tables
query I
SELECT COUNT(*) > 0 FROM duckdb_tables WHERE database_name = 'ora_lazy' AND table_name = 'ZZZ_READ_LIMIT_TARGET';
----
true

query I
SELECT COUNT(*) > 0 FROM information_schema.tables WHERE table_catalog = 'ora_lazy' AND table_name = 'ZZZ_READ_LIMIT_TARGET';
----
true

query III
SELECT column_name, data_type, is_nullable FROM duckdb_columns WHERE database_name = 'ora_lazy' AND table_name = 'ZZZ_READ_LIMIT_TARGET';
----
ID	DOUBLE	true

# Test 2d: Non-table synonym and unsupported column type resilience during schema scan
statement ok
SELECT oracle_execute(oracle_test_conn(), '
    BEGIN
       EXECUTE IMMEDIATE ''DROP SYNONYM syn_meta_test_seq'';
    EXCEPTION
       WHEN OTHERS THEN NULL;
    END;
')

statement ok
SELECT oracle_execute(oracle_test_conn(), '
    BEGIN
       EXECUTE IMMEDIATE ''DROP SEQUENCE meta_test_seq'';
    EXCEPTION
       WHEN OTHERS THEN NULL;
    END;
')

statement ok
SELECT oracle_execute(oracle_test_conn(), '
    BEGIN
       EXECUTE IMMEDIATE ''DROP TABLE meta_unsupported_long_tbl'';
    EXCEPTION
       WHEN OTHERS THEN NULL;
    END;
')

statement ok
SELECT oracle_execute(oracle_test_conn(), '
    BEGIN
       EXECUTE IMMEDIATE ''DROP TABLE meta_dynamic_ddl_tbl'';
    EXCEPTION
       WHEN OTHERS THEN NULL;
    END;
')

statement ok
SELECT oracle_execute(oracle_test_conn(), 'CREATE SEQUENCE meta_test_seq')

statement ok
SELECT oracle_execute(oracle_test_conn(), 'CREATE SYNONYM syn_meta_test_seq FOR meta_test_seq')

statement ok
SELECT oracle_execute(oracle_test_conn(), 'CREATE TABLE meta_unsupported_long_tbl (id NUMBER NOT NULL, payload LONG)')

statement ok
SELECT oracle_clear_cache();

query I
SELECT COUNT(*) > 0 FROM duckdb_tables() WHERE database_name = 'ora_lazy';
----
true

query I
SELECT COUNT(*) FROM duckdb_tables() WHERE database_name = 'ora_lazy' AND table_name IN ('SYN_META_TEST_SEQ', 'META_UNSUPPORTED_LONG_TBL');
----
0

query I
SELECT COUNT(*) > 0 FROM duckdb_columns() WHERE database_name = 'ora_lazy';
----
true

statement error
SELECT * FROM ora_lazy.meta_unsupported_long_tbl;
----
Unsupported Oracle type "LONG"

# Test 2e: Dynamic DDL invalidation and NOT NULL constraint discovery
statement ok
SELECT oracle_execute(oracle_test_conn(), 'CREATE TABLE meta_dynamic_ddl_tbl (id NUMBER(10,0) NOT NULL, label VARCHAR2(20))')

query I
SELECT COUNT(*) FROM duckdb_tables() WHERE database_name = 'ora_lazy' AND table_name = 'META_DYNAMIC_DDL_TBL';
----
1

query II
SELECT column_name, is_nullable FROM duckdb_columns WHERE database_name = 'ora_lazy' AND table_name = 'META_DYNAMIC_DDL_TBL' ORDER BY column_index;
----
ID	false
LABEL	true

statement ok
SELECT oracle_execute(oracle_test_conn(), 'DROP TABLE meta_dynamic_ddl_tbl')

statement ok
SELECT oracle_execute(oracle_test_conn(), 'DROP TABLE meta_unsupported_long_tbl')

statement ok
SELECT oracle_execute(oracle_test_conn(), 'DROP SYNONYM syn_meta_test_seq')

statement ok
SELECT oracle_execute(oracle_test_conn(), 'DROP SEQUENCE meta_test_seq')

# Test 3: Query table in current schema (should work)
# Assumes duckdb_test schema has at least DUAL or a test table
query I
SELECT COUNT(*) FROM oracle_query(oracle_test_conn(),
    'SELECT 1 FROM DUAL');
----
1

# Test 4: Detach and test with lazy loading disabled
statement ok
DETACH ora_lazy;

statement ok
SET oracle_lazy_schema_loading = false;

# Test 5: Attach with lazy loading disabled - should enumerate all schemas
statement ok
ATTACH '' AS ora_full (TYPE oracle, SECRET oracle_meta_test);

# Test 6: Verify multiple schemas enumerated when lazy loading disabled
query I
SELECT COUNT(*) FROM duckdb_schemas() WHERE database_name = 'ora_full';
----
<REGEX>:[1-9][0-9]*

# Test 7: Detach and test metadata object types filtering
statement ok
DETACH ora_full;

statement ok
SET oracle_metadata_object_types = 'TABLE';

# Test 8: Attach with only TABLE object type
statement ok
ATTACH '' AS ora_tables (TYPE oracle, SECRET oracle_meta_test);

# Test 9: Verify only tables are enumerated (views should not appear)
# This is a smoke test - actual verification would need specific test schema
statement ok
DETACH ora_tables;

# Test 10: Test metadata object types with multiple types
statement ok
SET oracle_metadata_object_types = 'TABLE,VIEW';

statement ok
ATTACH '' AS ora_multi (TYPE oracle, SECRET oracle_meta_test);

statement ok
DETACH ora_multi;

# Test 11: Test metadata result limit
statement ok
SET oracle_metadata_result_limit = 100;
SET oracle_lazy_schema_loading = true;

statement ok
ATTACH '' AS ora_limited (TYPE oracle, SECRET oracle_meta_test);

# Test 12: Verify attachment succeeded even with low limit
query I
SELECT COUNT(*) FROM duckdb_schemas() WHERE database_name = 'ora_limited';
----
<REGEX>:[1-9][0-9]*

statement ok
DETACH ora_limited;

# Test 13: Test metadata result limit = 0 (runtime uses default bounded limit)
statement ok
SET oracle_metadata_result_limit = 0;

statement ok
ATTACH '' AS ora_unlimited (TYPE oracle, SECRET oracle_meta_test);

statement ok
DETACH ora_unlimited;

# Test 14: Test on-demand loading - set very low limit, query table beyond limit
statement ok
SET oracle_metadata_result_limit = 1;
SET oracle_lazy_schema_loading = true;

statement ok
ATTACH '' AS ora_ondemand (TYPE oracle, SECRET oracle_meta_test);

# Test 15: Query a table that might not be in first 1 enumerated
# This tests attached-catalog on-demand loading fallback.
query I
SELECT COUNT(*) FROM ora_ondemand.duckdb_test.zzz_read_limit_target;
----
1

query I
SELECT COUNT(*) FROM oracle_query(oracle_test_conn(),
    'SELECT 1 FROM DUAL');
----
1

statement ok
DETACH ora_ondemand;

# Test 16: Test current schema detection
statement ok
SET oracle_lazy_schema_loading = true;
SET oracle_metadata_result_limit = 10000;

statement ok
ATTACH '' AS ora_schema (TYPE oracle, SECRET oracle_meta_test);

# Test 17: Verify oracle_clear_cache function works
query I
SELECT oracle_clear_cache();
----
<REGEX>:.*cleared.*

statement ok
DETACH ora_schema;

# Test 18: Test combining all metadata settings
statement ok
SET oracle_lazy_schema_loading = true;
SET oracle_metadata_object_types = 'TABLE,VIEW,SYNONYM,MATERIALIZED VIEW';
SET oracle_metadata_result_limit = 10000;
SET oracle_use_current_schema = true;

statement ok
ATTACH '' AS ora_combined (TYPE oracle, SECRET oracle_meta_test);

# Test 19: Verify combined settings work
query I
SELECT COUNT(*) FROM duckdb_schemas() WHERE database_name = 'ora_combined';
----
<REGEX>:[1-9][0-9]*

statement ok
DETACH ora_combined;

# Test 20: Reset all settings to defaults
statement ok
SET oracle_lazy_schema_loading = true;
SET oracle_metadata_object_types = 'TABLE,VIEW,SYNONYM,MATERIALIZED VIEW';
SET oracle_metadata_result_limit = 10000;
SET oracle_use_current_schema = true;

# Cleanup
statement ok
SELECT oracle_execute(oracle_test_conn(), 'DROP TABLE zzz_read_limit_target')

statement ok
SELECT oracle_execute(oracle_test_conn(), 'DROP TABLE aaa_read_limit_source')

statement ok
DROP SECRET oracle_meta_test;
