SELECT id
FROM ora_pushdown_off.duckdb_test.read_pushdown_baseline
WHERE amount BETWEEN 100 AND 250
ORDER BY id;
----
2

query I
SELECT id
FROM ora_pushdown_off.duckdb_test.read_pushdown_baseline
WHERE created_at BETWEEN DATE '2024-02-01' AND DATE '2024-03-01'
ORDER BY id;
----
2
3

query I
SELECT id
FROM ora_pushdown_off.duckdb_test.read_pushdown_baseline
WHERE id IN (1, 3)
ORDER BY id;
----
1
3

query I
SELECT id
FROM ora_pushdown_off.duckdb_test.read_pushdown_baseline
WHERE category LIKE 'b%'
ORDER BY id;
----
2
